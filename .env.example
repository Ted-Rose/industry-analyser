# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Database Configuration
# Production PostgreSQL (comment out for local development)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Local SQLite (uncomment for local development)
DATABASE_URL=sqlite:///db.sqlite3

# SSL Certificate for Database (required for production PostgreSQL)
# Format: Single line with \n escape sequences
# DB_SSL_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
HARD_CODED_PASSWORD=your-password-here

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
OMDB_KEY=your-omdb-key-here

# Other Settings
BASE_URL=http://127.0.0.1:8000
BILLING_ACCOUNT_ID=your-billing-account-id

# Sentry error monitoring (optional — empty disables it entirely)
# SENTRY_DSN=            # backend project DSN
# SENTRY_WEB_DSN=        # browser project DSN, shipped in spa-bootstrap
# SENTRY_ENVIRONMENT=    # override; defaults to production on Cloud Run

# Optional: extra host for ALLOWED_HOSTS (e.g. LAN IP for testing)
# ALLOWED_HOST_IP=

# News digest -> Google task + "Sign in with Google" (optional;
# unset = both features off and the sign-in button is hidden).
# GOOGLE_OAUTH_CLIENT_JSON is the OAuth client secrets document
# from GCP Console — the full {"web": {...}} JSON on one line.
# The client's registered redirect URIs must include
# <BASE_URL>/google/callback (shared by both flows). The consent
# screen needs these scopes: openid, userinfo.email,
# userinfo.profile (sign-in) and auth/tasks (digest). Sign in
# via GET /google/signin/ (add ?tasks=1 to grant digest access
# in the same consent), or connect an existing login via
# GET /google/login, then subscribe on /news/preferences/.
# GOOGLE_OAUTH_CLIENT_JSON=
# Task list the digest task lands in (auto-created; default News).
# GOOGLE_TASKS_LIST_TITLE=

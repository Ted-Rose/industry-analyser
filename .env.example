# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

SECRET_KEY=your-secret-key-here
DEBUG=True
BASE_URL=http://127.0.0.1:8000
HARD_CODED_PASSWORD=
GEMINI_API_KEY=

# Database — defaults to local SQLite if unset.
# For remote PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Optional: extra host for ALLOWED_HOSTS (e.g. machine LAN IP for phone testing).
# ALLOWED_HOST_IP=

# Remote Postgres TLS: same CA PEM as Vercel `capem`. Either `DB_SSL_CERT` or `capem`.
# Written to /tmp/industry-analyser-postgres-ca.pem at startup.
# DB_SSL_CERT=
# capem=

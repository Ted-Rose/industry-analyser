# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Database Configuration
# Production PostgreSQL (comment out for local development)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Local SQLite (uncomment for local development)
DATABASE_URL=sqlite:///db.sqlite3

# SSL Certificate for Database (required for production PostgreSQL)
# Format: Single line with \n escape sequences
# DB_SSL_CERT="-----BEGIN CERTIFICATE-----\nYOUR_CERT_CONTENT_HERE\n-----END CERTIFICATE-----"

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
HARD_CODED_PASSWORD=your-password-here

# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
OMDB_KEY=your-omdb-key-here

# Other Settings
BASE_URL=http://127.0.0.1:8000
BILLING_ACCOUNT_ID=your-billing-account-id

# Optional: extra host for ALLOWED_HOSTS (e.g. machine LAN IP for phone testing)
# ALLOWED_HOST_IP=

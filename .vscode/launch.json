        "django": true,
        "justMyCode": true,
        "cwd": "${workspaceFolder}",
        "python": "${workspaceFolder}/venv/bin/python",
        "console": "integratedTerminal",
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
        }
    },
    {
        "name": "Scrape Vacancy Portal 3 (cv.lv IT category)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/manage.py",
        "args": [
            "shell",
            "-c",
            "from fetcher.scraper import VacancyScrapper; scraper = VacancyScrapper(portal_id=3); scraper.run()"

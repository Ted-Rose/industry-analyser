{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Refetch: Dry Run (10 records)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "refetch_apartment_ads",
                "--filter", "post_date__isnull=True",
                "--deal-type", "rent",
                "--limit", "10",
                "--dry-run"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Refetch: Process 50 records",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "refetch_apartment_ads",
                "--filter", "post_date__isnull=True",
                "--deal-type", "rent",
                "--limit", "50"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Refetch: Specific IDs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "refetch_apartment_ads",
                "--ids", "PUT_YOUR_AD_IDS_HERE",
                "--deal-type", "rent"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Refetch: Custom Filter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "refetch_apartment_ads",
                "--filter", "house_type__isnull=True",
                "--fields", "house_type,facilities",
                "--deal-type", "rent",
                "--limit", "20"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Scrape: Apartment Ads",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "scrape_apartment_ads",
                "--max-pages", "5"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}

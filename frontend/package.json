{
  "name": "industry-analyser-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "for entry in vacancies tv classified_ads dashboard receipts; do openapi-typescript openapi.json -o src/$entry/api-types.ts || exit 1; done",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@sentry/react": "^11.9.0",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }

{"openapi": "3.1.0", "info": {"title": "industry-analyser API", "version": "0.1.0", "description": ""}, "paths": {"/api/vacancies/": {"get": {"operationId": "fetcher_api_list_vacancies", "summary": "List Vacancies", "parameters": [{"in": "query", "name": "include_keywords", "schema": {"default": [], "items": {"type": "string"}, "title": "Include Keywords", "type": "array"}, "required": false}, {"in": "query", "name": "exclude_keywords", "schema": {"default": [], "items": {"type": "string"}, "title": "Exclude Keywords", "type": "array"}, "required": false}, {"in": "query", "name": "include_industries", "schema": {"default": [], "items": {"type": "string"}, "title": "Include Industries", "type": "array"}, "required": false}, {"in": "query", "name": "show_active_only", "schema": {"default": false, "title": "Show Active Only", "type": "boolean"}, "required": false}, {"in": "query", "name": "page", "schema": {"default": 1, "title": "Page", "type": "integer"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VacanciesOut"}}}}}, "description": "Vacancy list page payload — mirrors the retired\nfind_vacancies view's filtering exactly."}}, "/api/vacancies/companies/": {"get": {"operationId": "fetcher_api_list_companies", "summary": "List Companies", "parameters": [{"in": "query", "name": "q", "schema": {"default": "", "maxLength": 255, "title": "Q", "type": "string"}, "required": false}, {"in": "query", "name": "page", "schema": {"default": 1, "title": "Page", "type": "integer"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompaniesOut"}}}}}, "description": "Company list — mirrors company_list: canonical companies\nonly (merged-away rows hidden), name/reg-code search."}}, "/api/vacancies/companies/{pk}/": {"get": {"operationId": "fetcher_api_company_detail", "summary": "Company Detail", "parameters": [{"in": "path", "name": "pk", "schema": {"format": "uuid", "title": "Pk", "type": "string"}, "required": true}, {"in": "query", "name": "page", "schema": {"default": 1, "title": "Page", "type": "integer"}, "required": false}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompanyDetailOut"}}}}}, "description": "Company detail — mirrors the company_detail view. A merged\ncompany resolves to its canonical survivor (the old view 301'd\nthere; the API returns the canonical record directly)."}}, "/api/vacancies/keywords/": {"post": {"operationId": "fetcher_api_add_keyword", "summary": "Add Keyword", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeywordSavedOut"}}}}}, "description": "Create a keyword — session-auth replacement for the retired\nHARD_CODED_PASSWORD form. Validation still goes through\nKeywordForm so name normalization/uniqueness are unchanged.", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/KeywordIn"}}}, "required": true}, "security": [{"SessionAuth": []}]}}, "/api/tv/programs/": {"get": {"operationId": "tv_programs_api_list_programs", "summary": "List Programs", "parameters": [{"in": "query", "name": "content_rating", "schema": {"anyOf": [{"maxLength": 50, "type": "string"}, {"type": "null"}], "title": "Content Rating"}, "required": false}, {"in": "query", "name": "not_content_rating", "schema": {"anyOf": [{"maxLength": 50, "type": "string"}, {"type": "null"}], "title": "Not Content Rating"}, "required": false}, {"in": "query", "name": "rating_value", "schema": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Rating Value"}, "required": false}, {"in": "query", "name": "ratio", "schema": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Ratio"}, "required": false}, {"in": "query", "name": "start_date", "schema": {"anyOf": [{"forma